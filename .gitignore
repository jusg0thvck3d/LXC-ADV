# ---------------------------
# Terraform core
# ---------------------------

.terraform/
.terraform.lock.hcl

# State files (NEVER commit)
*.tfstate
*.tfstate.*
crash.log

# ---------------------------
# Variable files (secrets)
# ---------------------------

# Real values
terraform.tfvars
terraform.tfvars.json

# Any custom tfvars
*.tfvars
*.tfvars.json

# Allow example files
!terraform.tfvars.example

# ---------------------------
# CLI variable overrides
# ---------------------------

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------
# Sensitive outputs / plans
# ---------------------------

*.tfplan
*.plan

# ---------------------------
# SSH / keys / local secrets
# ---------------------------

*.pem
*.key
*.pub
id_rsa
id_ed25519

# ---------------------------
# Editor / OS junk
# ---------------------------

.DS_Store
.vscode/
.idea/
*.swp
*.swo